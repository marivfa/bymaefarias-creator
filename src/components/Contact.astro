---
import { site } from '../data/site';
import Brand from './Brand.astro';
const { c } = Astro.props;
---
<section class="contact-wrap" id="contact">
  <div class="contact shell" data-reveal>
    <div class="contact-copy">
      <p class="eyebrow">{c.contact.eyebrow}</p>
      <h2>{c.contact.title}</h2>
      <p>{c.contact.body}</p>
    </div>

    <div class="contact-actions">
      <p class="hand-note contact-note">your brand, naturally part of the story ♡</p>
      <a class="button button-coral contact-button" href={`mailto:${site.email}`}>{c.contact.cta} <span>↗</span></a>
      <div class="contact-details">
        <a class="contact-line" href={`mailto:${site.email}`}>
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
          </span>
          <span>{site.email}</span>
        </a>
        <a class="contact-line" href={site.instagram} target="_blank" rel="noreferrer">
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="icon-dot"/></svg>
          </span>
          <span>{site.handle} ↗</span>
        </a>
      </div>
    </div>
    <span class="contact-shape contact-shape-1" aria-hidden="true"></span>
    <span class="contact-shape contact-shape-2" aria-hidden="true"></span>
  </div>
</section>
<footer class="footer shell">
  <Brand small={true} />
  <span>Food · Motherhood · Everyday Lifestyle</span>
  <span>{site.location}</span>
  <a href={c.alternatePath}>{c.lang.toUpperCase()} / {c.alternateLabel}</a>
</footer>
