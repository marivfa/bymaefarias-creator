---
const { item, lang, originalLabel } = Astro.props;
const hasVideo = Boolean(item.videoSrc);
const hasPoster = Boolean(item.poster);
---
<article class="media-card" data-reveal>
  {hasVideo ? (
    <div class={`media-frame media-frame-video ${hasPoster ? 'has-poster' : ''}`}>
      <video
        data-portfolio-video
        muted
        playsinline
        preload="metadata"
        poster={item.poster || undefined}
        aria-label={`${item.title[lang]} video`}
      >
        <source src={item.videoSrc} type="video/mp4" />
      </video>
      {hasPoster && <img class="video-poster" src={item.poster} alt={`${item.title[lang]} thumbnail`} loading="lazy" />}
      <button class="play-badge video-toggle" type="button" aria-label={`Play or pause ${item.title[lang]}`} data-play-toggle>
        <span class="play-icon" aria-hidden="true">▶</span>
      </button>
    </div>
  ) : hasPoster ? (
    <div class="media-frame">
      <img src={item.poster} alt={`${item.title[lang]} thumbnail`} loading="lazy" />
    </div>
  ) : (
    <div class="media-frame">
      <div class={`placeholder placeholder-${item.slug}`}>
        <span class="placeholder-tag">{item.eyebrow[lang]}</span>
        <strong>{item.title[lang]}</strong>
        <span class="placeholder-hint">Add video / poster</span>
      </div>
    </div>
  )}

  <div class="media-meta">
    <h3>{item.title[lang]}</h3>
    <p>{item.eyebrow[lang]}</p>
    <a class="text-link" href={item.reelUrl} target="_blank" rel="noreferrer">{originalLabel} ↗</a>
  </div>
</article>
