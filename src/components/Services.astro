---
const { c } = Astro.props;
const icons = [
  `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 3.2c-7.7.2-13.1 3.2-15.7 8.7-1.2 2.5-1 5.1-.1 7.2 2.1.2 4.5-.3 6.5-1.7 4.8-3.3 6.9-9.5 9.3-14.2Z"/><path d="M4.4 20c2.5-4.1 6.3-7.6 11.5-10.3"/></svg>`,
  `<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="3"/><path d="M8 6 9.5 3.8h5L16 6"/><circle cx="12" cy="13" r="4"/></svg>`,
  `<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg>`
];
---
<section class="services-wrap">
  <div class="section shell services" data-reveal>
    <div>
      <p class="eyebrow">{c.services.eyebrow}</p>
      <h2>{c.services.title}</h2>
    </div>
    <div class="service-list">
      {c.services.items.map((item, index) => (
        <div class="service-item">
          <span class="service-icon" set:html={icons[index]}></span>
          <span class="service-label">{item}</span>
        </div>
      ))}
    </div>
  </div>
</section>
